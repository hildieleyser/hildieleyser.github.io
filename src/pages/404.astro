---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Page not found" description="That page does not exist.">
  <section class="nf">
    <div class="shell">
      <p class="eyebrow">404</p>
      <h1>That page does not exist</h1>
      <p>The link may be out of date. Everything lives off the home page.</p>
      <p class="actions">
        <a class="btn btn--primary" href="/">Back to the home page <Icon name="arrow" size={15} /></a>
        <a class="btn" href="/cv/">View CV</a>
      </p>
    </div>
  </section>
</Base>
<style>
  .nf { padding-block: clamp(5rem, 14vw, 10rem); max-width: 44rem; }
  .nf h1 { font-size: var(--step-3); margin-bottom: 1rem; }
  .nf p { color: var(--text-2); }
  .actions { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 2rem; }
</style>
