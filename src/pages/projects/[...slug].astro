---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { stripBackdrop } from '../../lib/diagram';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  const ordered = projects.sort((a, b) => a.data.order - b.data.order);
  return ordered.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      // Next project in the running order, wrapping at the end.
      next: ordered[(i + 1) % ordered.length],
    },
  }));
}

const { project, next } = Astro.props;
const { title, tag, year, summary, role, stack, cover, coverAlt, gallery, diagram, diagramAlt, links } = project.data;
const { Content } = await render(project);

const iconFor = (label: string) =>
  label === 'GitHub' ? 'github' : label === 'Itch.io' ? 'gamepad' : label === 'Devpost' ? 'award' : 'external';

// Diagrams live in src/assets and are inlined so they scale with the page.
const diagrams = import.meta.glob<string>('../../assets/projects/*.svg', { query: '?raw', import: 'default' });
const rawDiagram = diagram ? await diagrams[`../../assets/projects/${diagram}`]?.() : undefined;
const diagramSvg = rawDiagram ? stripBackdrop(rawDiagram) : undefined;
---

<Base title={title} description={summary}>
  <article class="project">
    <div class="shell">
      <a class="back" href="/#work"><Icon name="arrow" size={14} class="flip" /> All work</a>

      <header class="project__head">
        <p class="project__tag">{tag} · {year}</p>
        <h1>{title}</h1>
        <p class="project__summary">{summary}</p>

        {links.length > 0 && (
          <div class="project__links">
            {links.map((link) => (
              <a class="btn" href={link.url} rel="noopener" target="_blank">
                <Icon name={iconFor(link.label) as any} size={15} /> {link.label}
              </a>
            ))}
          </div>
        )}
      </header>

      {cover && (
        <figure class="project__cover">
          <Image
            src={cover}
            alt={coverAlt ?? title}
            widths={[640, 960, 1280]}
            sizes="(max-width: 1180px) 92vw, 1080px"
            loading="eager"
          />
        </figure>
      )}

      <div class="project__grid">
        <div class="project__prose">
          <Content />
        </div>

        <aside class="project__aside">
          {role.length > 0 && (
            <section>
              <h2>My part</h2>
              <ul class="rolelist">{role.map((r) => <li>{r}</li>)}</ul>
            </section>
          )}
          {stack.length > 0 && (
            <section>
              <h2>Stack</h2>
              <ul class="stacklist">{stack.map((s) => <li>{s}</li>)}</ul>
            </section>
          )}
        </aside>
      </div>

      {diagramSvg && (
        <figure class="project__diagram">
          <div class="plate" role="img" aria-label={diagramAlt ?? `${title} system diagram`} set:html={diagramSvg} />
          <figcaption>{diagramAlt ?? `${title} system diagram`}</figcaption>
        </figure>
      )}

      {gallery.length > 0 && (
        <section class="project__gallery">
          <h2 class="gallery-title">Gallery</h2>
          <div class="gallery">
            {gallery.map((shot) => (
              <figure>
                <Image
                  src={shot.src}
                  alt={shot.alt}
                  widths={[480, 800, 1200]}
                  sizes="(max-width: 760px) 92vw, 45vw"
                  loading="lazy"
                  decoding="async"
                />
                <figcaption>{shot.alt}</figcaption>
              </figure>
            ))}
          </div>
        </section>
      )}

      <nav class="project__next" aria-label="Next project">
        <a href={`/projects/${next.id}/`}>
          <span class="meta">Next project</span>
          <span class="project__next-title">{next.data.title} <Icon name="arrow" size={16} /></span>
        </a>
      </nav>
    </div>
  </article>
</Base>

<style>
  .project { padding-block: clamp(2rem, 5vw, 3.5rem) 0; }

  .back {
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-size: 0.85rem; text-decoration: none; color: var(--muted);
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }
  .back:hover { color: var(--white); }
  .back :global(.flip) { transform: rotate(180deg); }

  .project__head { max-width: 46rem; }
  .project__tag {
    font-size: 0.74rem; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--white); margin-bottom: 1rem;
  }
  .project__head h1 { font-size: var(--step-4); line-height: 1.05; margin-bottom: 1.1rem; }
  .project__summary { font-size: var(--step-1); color: var(--body); line-height: 1.55; }
  .project__links { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }

  .project__cover {
    margin: clamp(2.5rem, 6vw, 4rem) 0 0;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--blue-raised);
  }
  .project__cover :global(img) { width: 100%; }

  .project__grid {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr);
    margin-top: clamp(2.5rem, 6vw, 4rem);
    align-items: start;
  }
  @media (max-width: 860px) { .project__grid { grid-template-columns: 1fr; } }

  .project__prose { max-width: var(--measure); font-size: var(--step-1); line-height: 1.7; color: var(--body); }
  .project__prose :global(p + p) { margin-top: 1.35em; }
  .project__prose :global(p:first-child) { color: var(--white); }

  .project__aside { position: sticky; top: 6rem; display: grid; gap: 2rem; }
  @media (max-width: 860px) { .project__aside { position: static; } }
  .project__aside h2 {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.72rem; letter-spacing: 0.15em; text-transform: uppercase;
    color: var(--white); margin-bottom: 1rem;
    padding-bottom: 0.7rem; border-bottom: 1px solid var(--rule);
  }
  .rolelist { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.9rem; }
  .rolelist li {
    font-size: 0.92rem; color: var(--body); line-height: 1.55;
    padding-left: 1.1rem; position: relative;
  }
  .rolelist li::before {
    content: ''; position: absolute; left: 0; top: 0.62em;
    width: 5px; height: 5px; border-radius: 50%; background: var(--white);
  }
  .stacklist { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .stacklist li {
    font-size: 0.8rem; color: var(--body);
    border: 1px solid var(--rule); border-radius: 100px; padding: 0.22rem 0.7rem;
  }

  .project__diagram { margin: clamp(3rem, 7vw, 5rem) 0 0; }
  /* Diagrams were authored on white; a light plate keeps them legible. */
  .plate {
    background: #ffffff;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: clamp(1rem, 3vw, 2rem);
    overflow-x: auto;
  }
  .plate :global(svg) { width: 100%; height: auto; max-width: 100%; }
  figcaption { font-size: 0.82rem; color: var(--muted); margin-top: 0.85rem; }

  .project__gallery { margin-top: clamp(3rem, 7vw, 5rem); }
  .gallery-title {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.72rem; letter-spacing: 0.15em; text-transform: uppercase;
    color: var(--white); margin-bottom: 1.5rem;
  }
  .gallery { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); }
  .gallery figure { margin: 0; }
  .gallery :global(img) {
    border: 1px solid var(--rule); border-radius: var(--radius);
    background: var(--blue-raised); width: 100%;
  }

  .project__next { margin-top: clamp(3.5rem, 8vw, 6rem); border-top: 1px solid var(--rule); padding-top: 2rem; }
  .project__next a { display: grid; gap: 0.5rem; text-decoration: none; }
  .project__next-title {
    display: inline-flex; align-items: center; gap: 0.6rem;
    font-size: var(--step-2); color: var(--white);
  }
  .project__next a:hover .project__next-title { color: var(--white); }
</style>
