---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WorkIndex from '../components/WorkIndex.astro';
import NeuralField from '../components/NeuralField.astro';
import Icon from '../components/Icon.astro';
import { site, currently, capabilities, researchAreas } from '../data/site';

const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<Base
  title={site.name}
  description={`${site.role} in London. ${site.tagline} Head of Research at Netholabs, working across EEG, wearables, computer vision and machine learning.`}
  personSchema
>
  <!-- ------------------------------------------------------------ Hero -->
  <section class="hero">
    <NeuralField />
    <div class="shell hero__inner">
      <h1 class="hero__statement">
        <span>i turn</span>
        <span>behaviour</span>
        <span class="accent">into signal.</span>
      </h1>
      <div class="hero__foot">
        <p class="hero__who">Hildelith Leyser <span>{site.role}</span></p>
        <p class="hero__where">{site.location}</p>
      </div>
    </div>
    <span class="scroll-cue" aria-hidden="true">scroll</span>
  </section>

  <!-- ------------------------------------------------------------ Work -->
  <section id="work" class="section">
    <div class="shell">
      <p class="eyebrow">Selected work</p>
      <WorkIndex projects={projects} />
    </div>
  </section>

  <!-- ---------------------------------------------------- Capabilities -->
  <section id="capabilities" class="section section--tint">
    <div class="shell">
      <p class="eyebrow">Capabilities</p>
      <dl class="caps">
        {capabilities.map((group) => (
          <div class="caps__row">
            <dt>{group.area}</dt>
            <dd>{group.items.join(', ')}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- -------------------------------------------------------- Research -->
  <section id="research" class="section">
    <div class="shell">
      <p class="eyebrow">Research</p>
      <ul class="research">
        {researchAreas.map((area) => (
          <li>
            <h3>{area.title}</h3>
            <p class="meta">{area.meta}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- --------------------------------------------------------- Contact -->
  <section id="contact" class="section section--full">
    <div class="shell">
      <p class="eyebrow">Contact</p>
      <a class="mailto" href={`mailto:${site.email}`}>{site.email}</a>
      <ul class="currently">
        {currently.map((c) => (
          <li><span>{c.since}</span> {c.label}, {c.org}</li>
        ))}
      </ul>
      <div class="contact__links">
        <a class="btn" href={site.cv} download><Icon name="download" size={15} /> CV</a>
        <a class="btn" href={site.linkedin} rel="noopener" target="_blank"><Icon name="linkedin" size={15} /> LinkedIn</a>
        <a class="btn" href={site.github} rel="noopener" target="_blank"><Icon name="github" size={15} /> GitHub</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ------------------------------------------------------------- Hero */
  .hero {
    position: relative;
    overflow: hidden;
    min-height: 92svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: clamp(5rem, 12vw, 9rem) clamp(3rem, 6vw, 5rem);
  }
  .hero__inner { position: relative; z-index: 1; }

  .hero__statement {
    font-size: var(--step-4);
    line-height: 0.92;
    letter-spacing: -0.035em;
    display: grid;
  }
  .hero__statement .accent { color: var(--accent); }

  .hero__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: clamp(3rem, 8vw, 6rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }
  .hero__who { color: var(--ink); font-weight: 500; }
  .hero__who span {
    color: var(--muted);
    font-weight: 400;
    margin-left: 0.6rem;
  }
  .hero__where { color: var(--muted); }

  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 1.75rem;
    transform: translateX(-50%);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
    animation: drift 2.6s ease-in-out infinite;
  }
  @keyframes drift {
    0%, 100% { transform: translate(-50%, 0); opacity: 0.55; }
    50%      { transform: translate(-50%, 5px); opacity: 1; }
  }

  /* ----------------------------------------------------- Capabilities */
  .caps { margin: 0; border-top: 1px solid var(--border); }
  .caps__row {
    display: grid;
    grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
    gap: 0.4rem 2.5rem;
    padding: 1.15rem 0.5rem;
    border-bottom: 1px solid var(--border);
  }
  @media (max-width: 720px) { .caps__row { grid-template-columns: 1fr; } }
  .caps dt {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .caps dd { margin: 0; color: var(--muted); }

  /* --------------------------------------------------------- Research */
  .research { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--border); }
  .research li { padding: 1.4rem 0.5rem; border-bottom: 1px solid var(--border); }
  .research h3 { font-size: clamp(1.4rem, 2.6vw, 1.95rem); margin-bottom: 0.4rem; }

  /* ---------------------------------------------------------- Contact */
  .mailto {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 6vw, 4.25rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--ink);
    text-decoration: none;
    word-break: break-word;
  }
  .mailto:hover { color: var(--accent); }

  .currently {
    list-style: none;
    margin: clamp(2.5rem, 6vw, 4rem) 0 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
    color: var(--muted);
  }
  .currently span { color: var(--accent); font-variant-numeric: tabular-nums; margin-right: 0.5rem; }

  .contact__links { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2.5rem; }
</style>
