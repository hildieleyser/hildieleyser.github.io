---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { consulting } from '../data/consulting';

const enquiry = `mailto:${site.email}?subject=${encodeURIComponent('Consulting enquiry')}`;
---

<Base
  title="Consulting"
  description={`Neuroscience consulting from ${site.name}: neurotech study design, sham-controlled device protocols, evidence reviews, science advice for television, and expert calls.`}
>
  <div class="consult">
    <div class="shell">
      <header class="consult__head">
        <p class="eyebrow">Consulting</p>
        <h1>Neuroscience for teams building and backing neurotechnology</h1>
        <p class="consult__intro">{consulting.intro}</p>
        <p class="consult__avail">{consulting.availability}</p>
        <div class="consult__actions">
          <a class="btn btn--primary" href={enquiry}><Icon name="mail" size={15} /> Start a conversation</a>
          <a class="btn" href="/cv/">Full CV</a>
        </div>
      </header>

      <section class="block" aria-labelledby="services">
        <h2 id="services">What I do</h2>
        <ol class="services">
          {consulting.services.map((s, i) => (
            <li>
              <p class="services__num">{String(i + 1).padStart(2, '0')}</p>
              <div>
                <h3>{s.title}</h3>
                <p>{s.body}</p>
                <p class="services__format">{s.format}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section class="block" aria-labelledby="work">
        <h2 id="work">Recent work</h2>
        <div class="work">
          {consulting.work.map((w) => (
            <article>
              <h3>{w.client}</h3>
              <p class="work__what">{w.what}</p>
              <p>{w.body}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="block" aria-labelledby="background">
        <h2 id="background">Background</h2>
        <p class="prose">{consulting.background}</p>
      </section>

      <section class="block" aria-labelledby="process">
        <h2 id="process">How it works</h2>
        <ol class="process">
          {consulting.process.map((p) => (
            <li>
              <h3>{p.step}</h3>
              <p>{p.body}</p>
            </li>
          ))}
        </ol>
      </section>

      <section class="cta" aria-labelledby="contact-consult">
        <h2 id="contact-consult">Have a study, device or programme in mind?</h2>
        <p>Email a few lines about what you are working on and I will reply within two working days.</p>
        <a class="btn btn--primary" href={enquiry}><Icon name="mail" size={15} /> {site.email}</a>
      </section>
    </div>
  </div>
</Base>

<style>
  .consult { padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(3rem, 8vw, 6rem); }
  .consult__head { max-width: 52rem; margin-bottom: clamp(3rem, 7vw, 5rem); }
  .consult__head h1 { font-size: var(--step-3); margin-bottom: 1.25rem; }
  .consult__intro { color: var(--white); font-size: var(--step-1); line-height: 1.5; max-width: var(--measure); }
  .consult__avail { color: var(--muted); margin-top: 1rem; font-size: 0.95rem; }
  .consult__actions { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 2rem; }

  .block { margin-bottom: clamp(3rem, 7vw, 5rem); scroll-margin-top: 6rem; }
  .block h2, .cta h2 {
    font-size: var(--step-2);
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 1.75rem;
  }

  .services { list-style: none; margin: 0; padding: 0; display: grid; }
  .services li {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 1.25rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .services li:first-child { padding-top: 0.25rem; }
  .services__num { font-size: 0.8rem; letter-spacing: 0.12em; color: var(--muted); padding-top: 0.3rem; }
  .services h3, .work h3, .process h3 {
    font-family: var(--font-body);
    font-size: var(--step-1);
    font-weight: 600;
    color: var(--white);
    margin-bottom: 0.5rem;
  }
  .services p, .work p, .process p, .prose { color: var(--body); line-height: 1.65; max-width: var(--measure); }
  .services__format { color: var(--muted) !important; font-size: 0.88rem; margin-top: 0.6rem; }
  @media (max-width: 620px) { .services li { grid-template-columns: 1fr; gap: 0.4rem; } }

  .work { display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: 1.25rem; }
  .work article {
    background: var(--blue-raised);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: 1.5rem;
  }
  .work__what { color: var(--muted) !important; font-size: 0.85rem; letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 0.9rem; }

  .process { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 1.25rem; counter-reset: step; }
  .process li { border-top: 2px solid var(--white); padding-top: 1rem; counter-increment: step; }
  .process li::before { content: counter(step, decimal-leading-zero); display: block; font-size: 0.8rem; letter-spacing: 0.12em; color: var(--muted); margin-bottom: 0.5rem; }

  .cta { background: var(--blue-deep); border: 1px solid var(--rule); border-radius: var(--radius); padding: clamp(1.5rem, 4vw, 2.75rem); }
  .cta h2 { border-bottom: 0; padding-bottom: 0; margin-bottom: 0.75rem; }
  .cta p { color: var(--body); margin-bottom: 1.5rem; max-width: var(--measure); }
</style>
