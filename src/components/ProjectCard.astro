---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { CollectionEntry } from 'astro:content';
import { stripBackdrop } from '../lib/diagram';

interface Props { project: CollectionEntry<'projects'>; index?: number }
const { project, index = 0 } = Astro.props;
const { title, tag, summary, year, cover, coverAlt, stack, diagram, diagramAlt } = project.data;

// Projects without a photo still have a technical diagram. Showing that reads
// far better than an initials tile, and it tells the reader what the thing does.
const diagrams = import.meta.glob<string>('../assets/projects/*.svg', { query: '?raw', import: 'default' });
const rawDiagram = !cover && diagram ? await diagrams[`../assets/projects/${diagram}`]?.() : undefined;
const diagramSvg = rawDiagram ? stripBackdrop(rawDiagram) : undefined;
---

<article class="pcard" data-reveal={index}>
  <a class="pcard__link" href={`/projects/${project.id}/`}>
    <div class="pcard__media">
      {cover ? (
        <Image
          src={cover}
          alt={coverAlt ?? title}
          widths={[320, 480, 720]}
          sizes="(max-width: 700px) 92vw, (max-width: 1100px) 45vw, 360px"
          loading={index < 3 ? 'eager' : 'lazy'}
          decoding="async"
        />
      ) : diagramSvg ? (
        <div class="pcard__diagram" role="img" aria-label={diagramAlt ?? `${title} system diagram`} set:html={diagramSvg} />
      ) : (
        <span class="pcard__fallback" aria-hidden="true">{title.slice(0, 2)}</span>
      )}
      <span class="pcard__year">{year}</span>
    </div>

    <div class="pcard__body">
      <h3>{title}</h3>
      <p class="pcard__tag">{tag}</p>
      <p class="pcard__summary">{summary}</p>
      {stack.length > 0 && (
        <ul class="pcard__stack">
          {stack.slice(0, 4).map((s) => <li>{s}</li>)}
          {stack.length > 4 && <li class="more">+{stack.length - 4}</li>}
        </ul>
      )}
      <span class="pcard__cta">Read the build <Icon name="arrow" size={14} /></span>
    </div>
  </a>
</article>

<style>
  .pcard {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 0.25s ease, transform 0.25s ease, background-color 0.25s ease;
  }
  .pcard:hover { border-color: var(--border-strong); transform: translateY(-3px); background: var(--surface-raised); }
  .pcard:focus-within { border-color: var(--gold); }

  .pcard__link { display: grid; grid-template-rows: auto 1fr; height: 100%; text-decoration: none; color: inherit; }
  .pcard__link:focus-visible { outline-offset: -3px; }

  .pcard__media {
    position: relative;
    aspect-ratio: 16 / 10;
    background: linear-gradient(140deg, #241f16, #131313);
    display: grid;
    place-items: center;
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }
  .pcard__media :global(img) {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .pcard:hover .pcard__media :global(img) { transform: scale(1.04); }
  /* Diagrams are black ink on white; a warm plate keeps them readable and on-brand. */
  .pcard__diagram {
    width: 100%;
    height: 100%;
    background: #f6f2e9;
    display: grid;
    place-items: center;
    padding: 0.5rem;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .pcard__diagram :global(svg) { width: 100%; height: 100%; object-fit: contain; }
  .pcard:hover .pcard__diagram { transform: scale(1.03); }

  .pcard__fallback {
    font-family: var(--font-display);
    font-size: 1.6rem;
    letter-spacing: 0.1em;
    color: rgba(205, 164, 94, 0.55);
  }
  .pcard__year {
    position: absolute; top: 0.7rem; right: 0.7rem;
    background: rgba(14, 14, 14, 0.82);
    border: 1px solid var(--border-strong);
    border-radius: 4px;
    padding: 0.18rem 0.5rem;
    font-size: 0.7rem; letter-spacing: 0.08em;
    color: var(--text-2);
    backdrop-filter: blur(4px);
  }

  .pcard__body { padding: 1.4rem 1.4rem 1.5rem; display: grid; align-content: start; gap: 0.5rem; }
  .pcard__body h3 { font-size: var(--step-1); color: var(--text); }
  .pcard__tag { font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--gold); }
  .pcard__summary { color: var(--text-2); font-size: 0.94rem; line-height: 1.6; margin-top: 0.15rem; }

  .pcard__stack { display: flex; flex-wrap: wrap; gap: 0.4rem; list-style: none; margin: 0.6rem 0 0; padding: 0; }
  .pcard__stack li {
    font-size: 0.72rem;
    color: var(--text-3);
    border: 1px solid var(--border);
    border-radius: 100px;
    padding: 0.16rem 0.6rem;
    background: rgba(255, 255, 255, 0.015);
  }
  .pcard__stack .more { color: var(--gold); border-color: var(--gold-dim); }

  .pcard__cta {
    display: inline-flex; align-items: center; gap: 0.45rem;
    margin-top: 1rem; font-size: 0.85rem; font-weight: 500; color: var(--gold);
  }
  .pcard:hover .pcard__cta { color: var(--gold-bright); }
  .pcard__cta :global(svg) { transition: transform 0.25s ease; }
  .pcard:hover .pcard__cta :global(svg) { transform: translateX(3px); }
</style>
