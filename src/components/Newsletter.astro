---
import { services } from '../data/site';
// Renders nothing until a Loops form id is configured.
---
{services.loopsFormId && (
  <form
    class="news"
    method="POST"
    action={`https://app.loops.so/api/newsletter-form/${services.loopsFormId}`}
  >
    <label for="news-email">Occasional notes on neurotechnology and what I am building.</label>
    <div class="news__row">
      <input
        id="news-email"
        type="email"
        name="email"
        required
        autocomplete="email"
        placeholder="you@example.com"
      />
      <button type="submit" class="btn btn--primary">Subscribe</button>
    </div>
  </form>
)}

<style>
  .news { margin-top: clamp(2.5rem, 6vw, 4rem); max-width: 34rem; }
  .news label {
    display: block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1rem;
  }
  .news__row { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .news input {
    flex: 1 1 15rem;
    min-width: 0;
    background: transparent;
    border: 1px solid var(--rule-strong);
    color: var(--white);
    font: inherit;
    font-size: 0.95rem;
    padding: 0.8rem 1rem;
    border-radius: 0;
  }
  .news input::placeholder { color: var(--muted); }
  .news input:focus-visible { outline: 2px solid var(--white); outline-offset: 2px; }
</style>
